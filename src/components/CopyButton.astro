---
interface Props { text: string; class?: string; }
const { text, class: className } = Astro.props;
---
<button type="button" data-copy={text}
  class:list={['inline-flex h-9 shrink-0 items-center justify-center gap-1.5 rounded-lg border border-line bg-raised px-3 text-xs font-medium text-muted transition-colors hover:border-accent hover:text-accent', className]}
  aria-label="Copiar comando">
  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V6a2 2 0 0 1 2-2h9"/></svg>
  <span class="label">Copiar</span>
</button>

<script>
  async function copy(text: string) {
    try {
      await navigator.clipboard.writeText(text);
    } catch {
      const ta = document.createElement('textarea');
      ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0';
      document.body.appendChild(ta); ta.select(); document.execCommand('copy'); ta.remove();
    }
  }
  document.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-copy]');
    if (!btn) return;
    await copy(btn.dataset.copy || '');
    const label = btn.querySelector('.label')!;
    label.textContent = '¡Copiado!';
    btn.classList.add('!border-accent', '!text-accent');
    setTimeout(() => {
      label.textContent = 'Copiar';
      btn.classList.remove('!border-accent', '!text-accent');
    }, 1800);
  });
</script>
