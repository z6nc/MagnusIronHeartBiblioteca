---
// Usa *palabra* al final del título: el texto previo queda pequeño y la palabra resaltada, grande.
// Ej: "Comandos más usados en *Soporte TI*"
interface Props {
  title: string;
  description?: string;
  as?: "h1" | "h2";
}
const { title, description, as: Tag = "h2" } = Astro.props;
const parts = title.split(/(\*[^*]+\*)/).filter(Boolean);
---

<div class="reveal max-w-2xl">
  <Tag class="font-semibold tracking-tight">
    {
      parts.map((p) =>
        p.startsWith("*") ? (
          <span class="hl uppercase text-[2.75rem] font-bold leading-[1.02] sm:text-6xl lg:text-6xl">
            {p.slice(1, -1)}
          </span>
        ) : (
          <span class="mb-1 block text-lg font-medium leading-snug text-white sm:text-2xl">
            {p}
          </span>
        ),
      )
    }
  </Tag>
  {
    description && (
      <p class="mt-4 max-w-md text-base leading-relaxed text-white/70">
        {description}
      </p>
    )
  }
</div>
