---
import { getYouTubeVideoId, type Video } from "../data/videos";

interface Props {
  video: Video;
}

const { video } = Astro.props;
const videoId = getYouTubeVideoId(video.url);
const thumbnail =
  video.thumbnail ??
  (videoId ? `https://img.youtube.com/vi/${videoId}/hqdefault.jpg` : undefined);
---

<a
  href={video.url}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`Ver en YouTube: ${video.name}`}
  class="spot group block overflow-hidden rounded-xl border border-line bg-surface text-ink transition-colors"
>
  <div
    class:list={[
      "relative overflow-hidden bg-black",
      video.aspectRatio === "9:16" ? "aspect-[9/16]" : "aspect-video",
    ]}
  >
    {
      thumbnail ? (
        <img
          src={thumbnail}
          alt={`Portada del video: ${video.name}`}
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
        />
      ) : (
        <div class="flex h-full items-center justify-center text-sm text-muted">
          Portada no disponible
        </div>
      )
    }
    <span
      class="absolute inset-0 flex items-center justify-center bg-black/10"
      aria-hidden="true"
    >
      <span
        class="flex h-12 w-12 items-center justify-center rounded-full bg-black/75 text-white"
      >
        <svg viewBox="0 0 24 24" class="ml-1 h-6 w-6 fill-current">
          <path d="M8 5v14l11-7z" />
        </svg>
      </span>
    </span>
  </div>
  <div class="p-4">
    {video.category && (
      <p class="mb-2 font-mono text-xs uppercase tracking-wide text-accent">
        {video.category}
      </p>
    )}
    <h2 class="font-display text-lg font-semibold leading-snug">{video.name}</h2>
    <p class="mt-2 text-sm leading-relaxed text-muted">{video.description}</p>
    <span class="mt-4 inline-block text-sm font-medium text-accent">
      Ver en YouTube ↗
    </span>
  </div>
</a>
