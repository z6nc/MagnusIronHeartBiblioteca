---
interface Props {
  images?: string[];
  commandName: string;
}

const { images = [], commandName } = Astro.props;
---

{
  images.length > 0 && (
    <div
      data-image-gallery
      data-images={JSON.stringify(images)}
      data-command-name={commandName}
      class="mt-0"
    >
      <button
        type="button"
        data-image-viewer-trigger
        class="inline-flex h-9 items-center gap-2 rounded-lg border border-white/25 px-3 text-sm text-muted transition-colors hover:border-[rgba(var(--c),0.55)] hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[rgb(var(--c))]"
        aria-label={`Ver imágenes de ${commandName}`}
      >
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          aria-hidden="true"
        >
          <rect x="3" y="4" width="18" height="16" rx="2" />
          <circle cx="8.5" cy="9" r="1.5" />
          <path d="m3 16 4.5-4 3.5 3 2.5-2 7.5 5" />
        </svg>
        Ver imagen del comando
        {images.length > 1 && (
          <span class="text-xs text-muted">({images.length})</span>
        )}
      </button>

      <dialog
        data-image-viewer
        class="max-h-[90vh] max-w-[min(90vw,64rem)] rounded-xl border border-line bg-surface p-2 text-ink shadow-2xl backdrop:bg-black/80"
      >
        <div class="relative flex items-center justify-center">
          <button
            type="button"
            data-image-viewer-close
            class="absolute right-2 top-2 z-10 inline-flex h-9 w-9 items-center justify-center rounded-full border border-white/20 bg-black/70 text-xl text-ink transition-colors hover:bg-black"
            aria-label="Cerrar imagen"
          >
            <span aria-hidden="true">&times;</span>
          </button>
          <button
            type="button"
            data-image-viewer-prev
            class="absolute left-2 top-1/2 z-10 inline-flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-white/20 bg-black/70 text-2xl text-ink transition-colors hover:bg-black disabled:hidden"
            aria-label="Imagen anterior"
          >
            <span aria-hidden="true">&#8249;</span>
          </button>
          <img
            data-image-viewer-image
            alt=""
            class="max-h-[calc(90vh-1rem)] max-w-full rounded-lg object-contain"
          />
          <button
            type="button"
            data-image-viewer-next
            class="absolute right-2 top-1/2 z-10 inline-flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-white/20 bg-black/70 text-2xl text-ink transition-colors hover:bg-black disabled:hidden"
            aria-label="Imagen siguiente"
          >
            <span aria-hidden="true">&#8250;</span>
          </button>
        </div>
        <p
          data-image-viewer-counter
          class="mt-2 text-center text-xs text-muted"
        />
      </dialog>
    </div>
  )
}

<script>
  document
    .querySelectorAll<HTMLElement>("[data-image-gallery]")
    .forEach((gallery) => {
      const viewer = gallery.querySelector<HTMLDialogElement>(
        "[data-image-viewer]",
      );
      const viewerImage = gallery.querySelector<HTMLImageElement>(
        "[data-image-viewer-image]",
      );
      const closeButton = gallery.querySelector<HTMLButtonElement>(
        "[data-image-viewer-close]",
      );
      const trigger = gallery.querySelector<HTMLButtonElement>(
        "[data-image-viewer-trigger]",
      );
      const previousButton = gallery.querySelector<HTMLButtonElement>(
        "[data-image-viewer-prev]",
      );
      const nextButton = gallery.querySelector<HTMLButtonElement>(
        "[data-image-viewer-next]",
      );
      const counter = gallery.querySelector<HTMLElement>(
        "[data-image-viewer-counter]",
      );
      const imageUrls = JSON.parse(gallery.dataset.images ?? "[]") as string[];
      const commandLabel = gallery.dataset.commandName ?? "Comando";
      let currentIndex = 0;

      if (
        !viewer ||
        !viewerImage ||
        !closeButton ||
        !trigger ||
        !previousButton ||
        !nextButton ||
        !counter
      )
        return;

      const showImage = (index: number) => {
        currentIndex = (index + imageUrls.length) % imageUrls.length;
        viewerImage.src = imageUrls[currentIndex];
        viewerImage.alt = `${commandLabel} - imagen ${currentIndex + 1}`;
        counter.textContent = `${currentIndex + 1} / ${imageUrls.length}`;
        previousButton.disabled = imageUrls.length < 2;
        nextButton.disabled = imageUrls.length < 2;
      };

      trigger.addEventListener("click", () => {
        showImage(0);
        viewer.showModal();
      });
      previousButton.addEventListener("click", () =>
        showImage(currentIndex - 1),
      );
      nextButton.addEventListener("click", () => showImage(currentIndex + 1));
      closeButton.addEventListener("click", () => viewer.close());
      viewer.addEventListener("click", (event) => {
        if (event.target === viewer) viewer.close();
      });
    });
</script>
