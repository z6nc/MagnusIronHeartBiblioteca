---
import { getCommandsByCategory, type Category } from "../data/commands";
interface Props {
  category: Category;
  wide?: boolean;
  index?: number;
}
const { category, wide = false, index = 0 } = Astro.props;
const count = getCommandsByCategory(category.slug).length;
---

<a
  href={`/${category.slug}`}
  style={`--i:${index}`}
  class:list={[
    "category-card spot reveal group relative flex min-h-[180px] flex-col justify-between rounded-2xl border p-5 sm:min-h-[220px] sm:p-6",
    category.tone === "cyan" && "tone-cyan",
    category.tone === "green" && "tone-green",
    category.tone
      ? "border-[rgba(var(--c),0.25)] bg-[rgba(var(--c),0.05)] hover:border-[rgba(var(--c),0.55)]"
      : "border-line bg-surface hover:border-white/20",
    wide ? "bento-wide lg:col-span-4" : "lg:col-span-2",
  ]}
>
  <div class="flex items-start justify-between">
    <span
      class="flex h-11 min-w-11 items-center justify-center rounded-xl border border-line bg-black/60 px-2 font-mono text-sm font-bold text-[rgb(var(--c))]"
      >{category.icon}</span
    >
    <svg
      class="text-muted transition-all duration-300 group-hover:-translate-y-1 group-hover:translate-x-1 group-hover:text-[rgb(var(--c))]"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"><path d="M7 17L17 7M8 7h9v9"></path></svg
    >
  </div>
  <div class="mt-8">
    <h3
      class="font-display text-2xl font-semibold leading-tight tracking-tight"
    >
      {category.title}
    </h3>
    <p class="mt-1.5 text-sm text-muted">{category.description}</p>
    <p class="mt-3 font-mono text-xs text-[rgb(var(--c))]">{count} comandos</p>
  </div>
</a>
