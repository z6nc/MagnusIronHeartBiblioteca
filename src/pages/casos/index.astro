---
import Layout from '../../layouts/Layout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import CaseCard from '../../components/CaseCard.astro';
import { cases } from '../../data/cases';
---
<Layout title="Casos reales" description="Problemas reales resueltos con comandos y atajos de Windows, contados paso a paso.">
  <section class="page-intro relative overflow-hidden border-b border-line">
    <div class="relative mx-auto max-w-6xl px-4 pb-10 pt-10 sm:pb-14 sm:pt-14">
      <a href="/" class="mb-8 inline-block text-sm text-muted transition-colors hover:text-ink">← Inicio</a>
      <SectionHeading as="h1" title="Problemas reales resueltos con *comandos y atajos*" description="Casos de mi trabajo, contados paso a paso." />
    </div>
  </section>
  <section class="mx-auto max-w-6xl px-4 py-10 sm:py-14">
    <div class="bento-grid cases-bento-grid gap-4">{cases.map((c, i) => <CaseCard item={c} index={i} />)}</div>
  </section>
</Layout>
